+
+function makeSession(
+  negotiated: VisualAgentCapabilitySet,
+): VisualAgentUpstreamSession {
+  return {
+    negotiate: async () => negotiated,
+    send: async () => undefined,
+    subscribe: () => () => undefined,
+    close: async () => undefined,
+  };
+}
