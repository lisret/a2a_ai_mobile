+    cloudSplit: {
+      visionConnectionId: 'vision',
+      plannerConnectionId: 'planner',
+    },
+    localVisionCloudPlanner: {
+      localModelId: 'minicpm-v-4.6-q4',
+      plannerConnectionId: 'planner',
